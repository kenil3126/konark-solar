# Server
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio SMS - a Twilio phone number in E.164 format, e.g. +14155552671
TWILIO_SMS_FROM=+1XXXXXXXXXX

# Twilio WhatsApp - Twilio sandbox or approved sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Where new-inquiry alerts should be delivered (your business phone)
NOTIFY_SMS_TO=+1XXXXXXXXXX
NOTIFY_WHATSAPP_TO=whatsapp:+1XXXXXXXXXX
